# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# 构建产物与参考仓库不入库
/outputs/
/refs/
/coverage/

# Golden 测试失败时在测试同级目录生成的基准/实际差异图
/test/**/failures/

# 历史本地发布说明不再入库；正式归档在 GitHub Releases
/docs/releases/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Flutter DevTools related
devtools_options.yaml

# Android Studio will place build artifacts here
/android/.kotlin/
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# 密钥与敏感信息：签名私钥、密码、Play 签名导出文件等一律不入库
key.properties
signing.properties
*.jks
*.keystore
*.p12
*.pfx
*.pepk
*.pem
*.key
*.bks
# 上传 GitHub Secrets 时临时生成的 Base64 文本，禁止入库
/android/app/keystore.base64.txt

# Widget Preview related
.widget_preview/
